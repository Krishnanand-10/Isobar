{
  "name": "isobar",
  "version": "0.1.0",
  "description": "High-Throughput In-Memory Telemetry Engine with Spatio-Temporal Indexing & WebAssembly Zero-Copy Boundary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "wasm-pack build crates/isobar-core --target web --out-dir ../../pkg",
    "cargo:test": "cd crates/isobar-core && cargo test",
    "cargo:bench": "cd crates/isobar-core && cargo bench"
  },
  "keywords": [
    "telemetry-engine",
    "time-series",
    "spatial-indexing",
    "kd-tree",
    "r-tree",
    "webassembly",
    "rust",
    "zero-gc",
    "typedarrays",
    "atmospheric",
    "ads-b"
  ],
  "author": "Krishnanand Tiwari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishnanand-10/Isobar.git"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "motion": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.0.5"
  }
}
